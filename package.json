{
  "name": "memsync",
  "version": "1.0.0",
  "description": "MemSync: Edge-Orchestrated Habit & Workflow Copilot",
  "scripts": {
    "dev": "npm --prefix client run build && node server/src/index.js",
    "start": "node server/src/index.js",
